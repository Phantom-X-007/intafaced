#!/bin/sh
#
# Refuse direct push to main + require format:check before any push.
# THRIFT: thrift-preflight — docs thrash hard-fail; re-push waste gate
# (branch with ≥2 CI runs/24h needs THRIFT_LOCAL_GREEN=1 after pnpm verify).
# NEW work is never blocked by CI volume alone. THRIFT_ALLOW=1 overrides.
# Safety net only — --no-verify bypasses; real enforcement is branch protection (needs Pro).
#
# P1: format:check covers tooling/scripts/*.mjs (what red-trunked main via #471).
# Worktrees often lack node_modules — resolve prettier from git-common-dir parent.

TOP=$(git rev-parse --show-toplevel)

# --- thrift meter (runs-per-unit-of-work, never units of work) ---
if command -v node >/dev/null 2>&1 && [ -f "$TOP/tooling/ci/thrift-preflight.mjs" ]; then
  if ! (CDPATH= cd -- "$TOP" && node tooling/ci/thrift-preflight.mjs); then
    cat >&2 <<'THRIFT'

  ✖ thrift-preflight refused this push.

    Docs thrash hard-cap, OR re-push waste (branch already had ≥2 CI runs/24h
    without local green). NEW work is not blocked by CI volume alone.

    After pnpm verify:
      THRIFT_LOCAL_GREEN=1 git push
    Emergency only (note why in PR):
      THRIFT_ALLOW=1 git push

THRIFT
    exit 1
  fi
fi
COMMON_GIT=$(git rev-parse --git-common-dir)
# git-common-dir is e.g. /repo/.git or /repo/.git/worktrees/x → parent of .git is main checkout
REPO_ROOT=$(CDPATH= cd -- "$(dirname "$COMMON_GIT")" && pwd)
# when common-dir is /repo/.git, dirname is /repo; when relative .git, resolve
case "$COMMON_GIT" in
  /*) ;;
  *) REPO_ROOT=$(CDPATH= cd -- "$TOP/$(dirname "$COMMON_GIT")" && pwd) ;;
esac

PRETTIER=""
if [ -x "$TOP/node_modules/.bin/prettier" ]; then
  PRETTIER="$TOP/node_modules/.bin/prettier"
elif [ -x "$REPO_ROOT/node_modules/.bin/prettier" ]; then
  PRETTIER="$REPO_ROOT/node_modules/.bin/prettier"
fi

if [ -n "$PRETTIER" ]; then
  if ! (CDPATH= cd -- "$TOP" && "$PRETTIER" --check "**/*.{ts,tsx,mjs,js,md,json,yml,yaml}"); then
    cat >&2 <<'MSG'

  ✖ format:check failed — refuse push.

    Fix: prettier --write on the named files (or pnpm format from a full install).
    This is the gate that failed when #471 merged before CI (swarm.mjs).

MSG
    exit 1
  fi
elif command -v pnpm >/dev/null 2>&1; then
  if ! (CDPATH= cd -- "$TOP" && pnpm format:check); then
    echo "✖ pnpm format:check failed — refuse push." >&2
    exit 1
  fi
else
  echo "warn: no prettier binary found; skipping format:check on push" >&2
fi

protected="main"
remote_ref_prefix="refs/heads/"

while read -r local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#$remote_ref_prefix}"

  if [ "$branch" = "$protected" ]; then
    cat >&2 <<'MESSAGE'

  ✖ Direct push to main refused.

    main is always deployable and changes reach it through a reviewed PR
    (CONTRIBUTING.md §1).

    Instead:
      pnpm wt feat/your-change
      git push -u origin feat/your-change
      gh pr create --fill

    If you genuinely need to push main:
      git push --no-verify

MESSAGE
    exit 1
  fi
done

exit 0
