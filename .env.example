# INTAFACED — local development environment
# Copy to .env. Never commit .env. Prod secrets come from vault (§9).

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=dev
LOG_LEVEL=info

# §11 — the drop sequence is configuration. 0 · I · II · III · IV · V
LAUNCH_DROP=0

# ── Data ─────────────────────────────────────────────────────────────────────
# Each service connects with its OWN role and sees only its own schema.
# Format: postgres://svc_<name>:svc_<name>@localhost:5433/intafaced
# Host port is 5433 — a native Postgres usually owns 5432. Override the host
# side with POSTGRES_HOST_PORT if 5433 is taken on your machine too.
DATABASE_URL=postgres://intafaced_ops:intafaced_ops@localhost:5433/intafaced
TEST_DATABASE_URL=postgres://intafaced_ops:intafaced_ops@localhost:5433/intafaced
DATABASE_POOL_MAX=10
DATABASE_SSL=false

REDIS_URL=redis://localhost:6380

NATS_URL=nats://localhost:4222
NATS_STREAM_PREFIX=INTAFACED

# ── Observability (§9) ───────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Grafana: http://localhost:3001  (intafaced / intafaced)

# ── Auth (§4.1) ──────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-signing-secret-replace-me-before-anything-real
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=intafaced
JWT_AUDIENCE=intafaced.api

# ── Protocol Plane (§17.4 · svc-protocol) ────────────────────────────────────
# Non-custodial by architecture. Note what is NOT here and must never be added:
# no private key, mnemonic or signer secret — svc-protocol has no transaction it
# is entitled to originate on a user's account (§16.10).
PROTOCOL_CHAIN_ID=31337
PROTOCOL_RPC_URL=http://localhost:8545
# ERC-4337 v0.7 EntryPoint singleton — a public contract, not ours.
PROTOCOL_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
PROTOCOL_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
PROTOCOL_IMPLEMENTATION_ADDRESS=0x0000000000000000000000000000000000000000
# Optional. Without a bundler the user submits their own operations —
# convenience degrades, access does not.
# PROTOCOL_BUNDLER_URL=http://localhost:4337
PROTOCOL_RELAY_ENABLED=true

# ── Feature flag overrides ───────────────────────────────────────────────────
# Any flag in packages/config/src/flags.ts can be forced on or off:
#   INTAFACED_FLAG_<KEY_WITH_UNDERSCORES>=on|off
# INTAFACED_FLAG_TRADE_SPOT=on
# INTAFACED_FLAG_BLUEPRINT_ONBOARDING=on
