{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /**
     * Next owns the emit, so this project only ever typechecks. The overrides
     * below are the ones Next requires — if any of them drift, `next build`
     * rewrites this file on the spot, which is why they are set explicitly.
     */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "next.config.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".turbo"]
}
