{
  "name": "intafaced",
  "private": true,
  "version": "0.0.0",
  "description": "INTAFACED Sovereign OS — monorepo root. Law: INTAFACED_DEFINITIVE_BUILD.md",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "wt": "node tooling/scripts/worktree.mjs create",
    "wt:list": "node tooling/scripts/worktree.mjs list",
    "wt:rm": "node tooling/scripts/worktree.mjs remove",
    "verify": "turbo run build typecheck test && node tooling/ci/dod-gate.mjs",
    "gate": "node tooling/ci/dod-gate.mjs",
    "scan:brand": "node tooling/ci/brand-scan.mjs",
    "scan:custody": "node tooling/ci/custody-scan.mjs",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:check": "node tooling/ci/migration-check.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
