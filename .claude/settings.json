{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null); [ -f \"$ROOT/tooling/scripts/graphify-hook-guard-skip-grok.py\" ] && python3 \"$ROOT/tooling/scripts/graphify-hook-guard-skip-grok.py\" search || true"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null); [ -f \"$ROOT/tooling/scripts/graphify-hook-guard-skip-grok.py\" ] && python3 \"$ROOT/tooling/scripts/graphify-hook-guard-skip-grok.py\" read || true"
          }
        ]
      }
    ]
  }
}
