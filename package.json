{
  "name": "intafaced",
  "private": true,
  "version": "0.0.0",
  "description": "INTAFACED Sovereign OS — monorepo root. Law: INTAFACED_DEFINITIVE_BUILD.md",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "platform:up": "docker compose -f docker-compose.apps.yml up -d --build",
    "platform:down": "docker compose -f docker-compose.apps.yml down",
    "platform:logs": "docker compose -f docker-compose.apps.yml logs -f",
    "platform:ps": "docker compose -f docker-compose.apps.yml ps",
    "platform:reset": "docker compose -f docker-compose.apps.yml down -v && docker compose -f docker-compose.apps.yml up -d --build",
    "wt": "node tooling/scripts/worktree.mjs create",
    "wt:list": "node tooling/scripts/worktree.mjs list",
    "wt:rm": "node tooling/scripts/worktree.mjs remove",
    "tracker": "node tooling/scripts/tracker.mjs",
    "tracker:check": "node tooling/scripts/tracker.mjs --check",
    "scan:agent-autoload": "node tooling/ci/agent-autoload-scan.mjs",
    "gates": "node tooling/ci/gates.mjs",
    "verify": "pnpm gates && pnpm format:check && turbo run build typecheck test && node tooling/ci/dod-gate.mjs",
    "gate": "node tooling/ci/dod-gate.mjs",
    "scan:brand": "node tooling/ci/brand-scan.mjs",
    "scan:custody": "node tooling/ci/custody-scan.mjs",
    "scan:secrets": "node tooling/ci/secret-scan.mjs",
    "scan:vendor-shell": "node tooling/ci/vendor-shell-scan.mjs",
    "scan:vendor-java-money": "node tooling/ci/vendor-java-money-scan.mjs",
    "scan:dual-book-door": "node tooling/ci/dual-book-door-scan.mjs",
    "scan:test-db": "node tooling/ci/test-db-scan.mjs",
    "scan:i18n": "node tooling/ci/i18n-scan.mjs",
    "scan:i18n-bypass": "node tooling/ci/i18n-bypass-scan.mjs",
    "order-path-smoke": "node tooling/scripts/order-path-smoke.mjs",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:check": "node tooling/ci/migration-check.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,md,json,yml,yaml}\"",
    "scan:workspace": "node tooling/ci/workspace-sync.mjs",
    "ui:boot": "node tooling/uiproof/boot.mjs",
    "ui:proof": "node tooling/uiproof/boot.mjs && playwright test -c tooling/uiproof/playwright.config.mjs tooling/uiproof/proof.spec.mjs && node tooling/uiproof/report.mjs",
    "ui:proof:auth": "node tooling/uiproof/boot.mjs && playwright test -c tooling/uiproof/playwright.config.mjs tooling/uiproof/auth.spec.mjs",
    "ui:proof:pass3": "bash tooling/uiproof/run-pass3.sh",
    "frontend:preflight": "node tooling/frontend/preflight.mjs",
    "frontend:residual": "node tooling/frontend/residual-print.mjs",
    "frontend:preflight:craft": "SLICE_TYPE=CRAFT ORCA_REQUIRED=1 node tooling/frontend/preflight.mjs",
    "scan:dual-book-door-paths": "node tooling/ci/dual-book-door-path-unit.mjs",
    "dual-book:classify": "node tooling/scripts/dual-book-setbalance-classify.mjs",
    "order-path-cx8": "node tooling/scripts/order-path-cx8-boot.mjs",
    "claim:check": "node tooling/ci/claim-check.mjs",
    "wt:gc": "node tooling/scripts/worktree-gc.mjs",
    "wt:gc:apply": "node tooling/scripts/worktree-gc.mjs --apply"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
