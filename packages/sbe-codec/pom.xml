<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.intafaced</groupId>
  <artifactId>sbe-codec</artifactId>
  <version>0.0.0</version>
  <name>sbe-codec</name>
  <description>Real Logic SBE 1.39.0 codec adapter. Our schema. Not a matching engine. Not a book.</description>

  <properties>
    <!-- Pin: aeron-io/simple-binary-encoding 1.39.0 commit e773b57cac6b2008ce30dd219a33de49766c6013 -->
    <sbe.version>1.39.0</sbe.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.jupiter.version>5.11.4</junit.jupiter.version>
  </properties>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>uk.co.real-logic</groupId>
      <artifactId>sbe-tool</artifactId>
      <version>${sbe.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Agrona UnsafeBuffer on JDK 21. Official SBE runtime needs this open. -->
          <argLine>--add-opens java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>sbe-generate</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>uk.co.real_logic.sbe.SbeTool</mainClass>
              <arguments>
                <argument>${project.basedir}/schema/intafaced-md.xml</argument>
              </arguments>
              <systemProperties>
                <systemProperty>
                  <key>sbe.output.dir</key>
                  <value>${project.basedir}/src/main/java</value>
                </systemProperty>
              </systemProperties>
              <classpathScope>compile</classpathScope>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <mainClass>io.intafaced.sbe.SbeCodecMain</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
