# INTAFACED — local development environment
#
#   cp .env.example .env
#
# Never commit .env. Prod secrets come from vault (§9).
#
# ── READ THIS FIRST: the two fleet-wide secrets ──────────────────────────────
#
# EDGE_PRINCIPAL_SECRET and INTERNAL_SERVICE_SECRET are declared ONCE, near the
# top, and every service reads the same variable. They are not per-service
# values and there is no reason ever to have two of either:
#
#   · EDGE_PRINCIPAL_SECRET is the HMAC key over the principal the edge
#     forwards. The edge signs with it; each mounting service verifies with it.
#     Two different values means every authenticated request 401s.
#
#   · INTERNAL_SERVICE_SECRET is the shared secret on the internal money plane.
#     svc-ledger checks it; the six services that post to the ledger send it.
#     Two different values means every `ledger.post` 401s — a platform that
#     starts, looks healthy, and cannot move a single unit of value.
#
# Both are `z.string().min(32)` with NO default (packages/config/src/env.ts), so
# a service that has not been given one refuses to boot. `docker-compose.apps.yml`
# refuses to start at all. That is the design: this is a class of failure that
# must be loud at boot, never discovered at 3am inside a ledger post.
#
# Generate real ones with:  openssl rand -base64 48

EDGE_PRINCIPAL_SECRET=dev-only-edge-secret-at-least-32-chars-long
INTERNAL_SERVICE_SECRET=dev-only-internal-service-secret-at-least-32-chars

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=dev
LOG_LEVEL=info

# §11 — the drop sequence is configuration. 0 · I · II · III · IV · V
LAUNCH_DROP=0

# ── Data ─────────────────────────────────────────────────────────────────────
# Each service connects with its OWN role and sees only its own schema.
# Format: postgres://svc_<name>:svc_<name>@localhost:5433/intafaced
# Host port is 5433 — a native Postgres usually owns 5432. Override the host
# side with POSTGRES_HOST_PORT if 5433 is taken on your machine too.
#
# NOTE: these host-facing values are for processes you run on the HOST
# (`pnpm dev`, `vitest`, a psql session). Containers started by
# docker-compose.apps.yml do not read them — compose gives each service its own
# `postgres://svc_x:svc_x@postgres:5432/...` because inside the compose network
# the host is `postgres` and the port is 5432. See docs/RUNNING.md.
DATABASE_URL=postgres://intafaced_ops:intafaced_ops@localhost:5433/intafaced
# Tests that APPLY MIGRATIONS must use a dedicated DB — never the shared `intafaced`
# schema on 5433 (a branch once broke main's tests from another worktree that way).
# Compose creates `intafaced_test` via tooling/infra/postgres-init/02-intafaced-test-db.sh.
TEST_DATABASE_URL=postgres://intafaced_ops:intafaced_ops@localhost:5433/intafaced_test
TEST_DATABASE_URL_TRADE=postgres://svc_trade:svc_trade@localhost:5433/intafaced_test
# EVERY Postgres suite gets a line here. A suite whose variable is missing does
# not fail — it falls back to a default, and for a long time those defaults were
# the SHARED `intafaced` database. That is the exact hazard the comment above
# warns about, and it bites silently:
#
#   · svc-identity's KYC test asks for the oldest 200 pending records and
#     asserts its own new record is among them. The shared database accumulated
#     307 pending rows from other worktrees' runs, so a record created *now*
#     sorts past the window and the test fails with an assertion that looks
#     exactly like a real regression. Verified 59/59 green on intafaced_test,
#     58/59 on the shared database.
#   · svc-bank's §0.6 custody test reads the live schema and asserts no
#     undeclared money columns exist. An unmerged branch's `loan_*` tables,
#     applied to the shared database from another checkout, made `main` look
#     like it violated custody doctrine. 83/83 green on intafaced_test.
#
# Two further defences now exist so a stale .env cannot resurrect this:
#   1. every suite's code default is a *_test database, not `intafaced`;
#   2. `assertTestDatabase` (packages/db) asks Postgres for current_database()
#      and refuses to run unless the name ends in `_test`.
# This file is still the thing that makes a clean clone correct on first run.
TEST_DATABASE_URL_IDENTITY=postgres://svc_identity:svc_identity@localhost:5433/intafaced_test
TEST_DATABASE_URL_PAY=postgres://svc_pay:svc_pay@localhost:5433/intafaced_test
TEST_DATABASE_URL_TOKEN=postgres://svc_token:svc_token@localhost:5433/intafaced_test
TEST_DATABASE_URL_P2P=postgres://svc_p2p:svc_p2p@localhost:5433/intafaced_test
# These three were read by tooling/ci/assert-test-db-env.mjs and by their
# suites, but had no line here at all.
TEST_DATABASE_URL_BANK=postgres://svc_bank:svc_bank@localhost:5433/intafaced_test
TEST_DATABASE_URL_BLUEPRINT=postgres://svc_blueprint:svc_blueprint@localhost:5433/intafaced_test
TEST_DATABASE_URL_AGENTS=postgres://svc_agents:svc_agents@localhost:5433/intafaced_test
DATABASE_POOL_MAX=10
DATABASE_SSL=false

REDIS_URL=redis://localhost:6380

NATS_URL=nats://localhost:4222
NATS_STREAM_PREFIX=INTAFACED

# ── Observability (§9) ───────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Grafana: http://localhost:3001  (intafaced / intafaced)

# ── Auth (§4.1 · svc-identity) ───────────────────────────────────────────────
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-signing-secret-replace-me-before-anything-real
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=intafaced
JWT_AUDIENCE=intafaced.api
REGISTRATION_OPEN=true

# ── Payments (§6.1 · svc-pay) ────────────────────────────────────────────────
# Webhook signing secrets, minimum 32 characters, no defaults in the schema.
# A forged delivery on either endpoint says "this payment was captured" about
# money that never moved — so an unset secret fails startup rather than quietly
# verifying everything. Sandbox money is still a real state machine.
PAY_CRYPTO_WEBHOOK_SECRET=dev-only-crypto-webhook-secret-at-least-32-chars
PAY_CARD_SANDBOX_WEBHOOK_SECRET=dev-only-card-webhook-secret-at-least-32-chars
PAY_MIN_CONFIRMATIONS=6

# ── Native asset (§4.3 · svc-token, svc-bank) ────────────────────────────────
TOKEN_ASSET_ID=IFC

# ── Blueprint (§7.1 · svc-blueprint) ─────────────────────────────────────────
# The Neural Engine is an external deployment a clean clone does not have, so
# the default is the deterministic in-process engine. It is a MODE, not a
# fallback: pointing `http` at nothing would serve stub profiles to real people
# while reporting healthy.
BLUEPRINT_ENGINE_MODE=mock
# BLUEPRINT_ENGINE_URL=http://host.docker.internal:4108
# BLUEPRINT_ENGINE_API_KEY=

# ── Protocol Plane (§17.4 · svc-protocol) ────────────────────────────────────
# Non-custodial by architecture. Note what is NOT here and must never be added:
# no private key, mnemonic or signer secret — svc-protocol has no transaction it
# is entitled to originate on a user's account (§16.10).
#
# The chain is not ours and the compose stack does not run one. From inside a
# container, `host.docker.internal` reaches an anvil/hardhat node on your
# machine. Without one svc-protocol still starts; `/ready` reports 503.
PROTOCOL_CHAIN_ID=31337
PROTOCOL_RPC_URL=http://host.docker.internal:8545
# ERC-4337 v0.7 EntryPoint singleton — a public contract, not ours.
PROTOCOL_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
PROTOCOL_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
PROTOCOL_IMPLEMENTATION_ADDRESS=0x0000000000000000000000000000000000000000
# Optional. Without a bundler the user submits their own operations —
# convenience degrades, access does not.
# PROTOCOL_BUNDLER_URL=http://localhost:4337
PROTOCOL_RELAY_ENABLED=true

# ── Agents (§8.2 · svc-agents) ───────────────────────────────────────────────
# The model provider is DEPLOYMENT CONFIGURATION, never source. Doctrine §0.7
# keeps third-party system names out of everything that ships, and §1 requires
# providers to be swappable — both hold when the endpoint, the credential, the
# headers and the model ids arrive from here. Swapping providers is editing the
# block below and restarting.

# 'mock' is the default on purpose: a developer runs the fleet with no
# credential, and starting the service by accident cannot spend money.
AGENTS_PROVIDER=mock

AGENTS_FEE_ASSET_ID=IFC
# Billing window length. Must divide 1440 so a window never straddles midnight —
# the window id is half of the ledger idempotency key.
AGENTS_USAGE_WINDOW_MINUTES=60
# Kill-switch for billing. Usage is still RECORDED when this is off.
AGENTS_METERING_ENABLED=true

# Required only when AGENTS_PROVIDER=upstream. Prod values come from vault (§9).
# AGENTS_UPSTREAM_BASE_URL=https://engine.internal
# AGENTS_UPSTREAM_API_KEY=replace-me
# AGENTS_UPSTREAM_AUTH_HEADER=x-api-key
# AGENTS_UPSTREAM_AUTH_PREFIX=
# Static headers — protocol version pins, tenant ids.
# AGENTS_UPSTREAM_HEADERS={"x-protocol-version":"2026-01-01"}
# AGENTS_UPSTREAM_COMPLETIONS_PATH=/v1/messages
# AGENTS_UPSTREAM_EMBEDDINGS_PATH=/v1/embeddings
# Routing-table alias -> the concrete model id this upstream accepts.
# AGENTS_UPSTREAM_MODELS={"reasoning-lg":"","reasoning-md":"","fast-sm":"","embed-sm":""}
# AGENTS_UPSTREAM_TIMEOUT_MS=60000

# Full per-task routing table, overriding the built-in default (which is priced
# for development, not production).
# AGENTS_ROUTING_TABLE={"routes":[{"task":"navigator.plan","providerId":"primary","model":"reasoning-lg","maxOutputTokens":4096,"price":{"inputPerMillion":"3","outputPerMillion":"15"}}]}

# ── Host port overrides ──────────────────────────────────────────────────────
# Only the infrastructure ports are overridable; the application ports are
# fixed in docker-compose.apps.yml because several services would otherwise
# collide with each other (three of them default to 4004 in code).
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380

# ── Feature flag overrides ───────────────────────────────────────────────────
# Any flag in packages/config/src/flags.ts can be forced on or off:
#   INTAFACED_FLAG_<KEY_WITH_UNDERSCORES>=on|off
# INTAFACED_FLAG_TRADE_SPOT=on
# INTAFACED_FLAG_BLUEPRINT_ONBOARDING=on

# ── Sanctions / region screening (§24 Lane A) ────────────────────────────────
# EMPTY ON PURPOSE, AND STILL NEEDS COUNSEL.
#
# `checkAccess` has always been able to refuse a region and has never had a list
# to refuse from — so it cleared everyone and reported that as "screened". These
# two variables are how the list gets supplied, and svc-edge now REFUSES TO
# START with APP_ENV=staging or prod while they are unset. Dev and test are
# unaffected: an empty list logs a warning and boots.
#
# Comma-separated ISO-3166 alpha-2 codes, each optionally followed by ":reason".
# The reason is what a refused user sees and what the audit log carries.
#
#   INTAFACED_SANCTIONS_REGIONS="AA:UNSC resolution ref,BB:programme ref"
#
# WHAT GOES IN THE LIST IS A COMPLIANCE DECISION WITH A NAMED OWNER, not an
# engineering one. Do not guess it — too few entries is a sanctions breach, too
# many is unlawful discrimination. The placeholders above are not country codes.
# INTAFACED_SANCTIONS_REGIONS=
#
# Free-text provenance recorded on every screening decision: the governance
# record, counsel memo, or published list revision this came from.
# INTAFACED_SANCTIONS_LIST_SOURCE=

# ── svc-edge: the front door (§9) ────────────────────────────────────────────
# Turns a bearer token into the signed principal every mounted service requires.
# It reuses EDGE_PRINCIPAL_SECRET declared above — do not add a second copy.
#
# JWT_ACCESS_SECRET must match svc-identity's. A mismatch means every login
# succeeds and every request after it is anonymous, which presents to a user as
# "logged in but nothing works" and to an operator as no error at all.
EDGE_HTTP_PORT=4000
# Two-letter code, resolved server-side. XX is the region the jurisdiction
# matrix treats as unknown, so a deployment that forgets this is restrictive
# rather than accidentally open.
DEFAULT_REGION=XX
UPSTREAM_TIMEOUT_MS=15000

# ── svc-ws: the live depth stream (§5.2 ws.gateway) ──────────────────────────
# Reads svc-matching's UNAUTHENTICATED depth endpoint and re-broadcasts it. Note
# what is absent: this service gets no EDGE_PRINCIPAL_SECRET and no
# INTERNAL_SERVICE_SECRET, and that absence is the reason it is allowed to be a
# second public port. services/svc-ws/README.md argues it.
#
# Levels per side, and how often depth is read. One GET per SUBSCRIBED market
# per tick; markets nobody is watching are not polled at all.
WS_DEPTH_LIMIT=50
WS_POLL_INTERVAL_MS=250
# Kill-switch, mirroring the `ws.gateway` flag. Off refuses upgrades, closes
# every open socket with a reason, and returns 503 from /ready.
WS_GATEWAY_ENABLED=true

# ── apps/web: where the browser looks for the front door ─────────────────────
# NEXT_PUBLIC_ because the browser makes these calls — it is a public URL and
# must never hold a secret. Every request/response service apps/web talks to is
# behind this one origin.
NEXT_PUBLIC_EDGE_URL=http://localhost:4000

# The one exception, and it is structural rather than an oversight: svc-edge's
# proxy buffers with `response.text()`, so it cannot carry a websocket. The live
# order book is therefore a second origin the browser reaches directly. Unset
# means the book renders as unavailable with that reason on screen — never as a
# plausible ladder of numbers.
#
# NEXT_PUBLIC_* is inlined at BUILD time by Next, so changing this needs a
# rebuild of apps/web, not just a restart.
NEXT_PUBLIC_WS_URL=http://localhost:4014

# Browser origins for the vendored Java shell (CorsAllowlist).
# Local defaults already cover :8090/:3000/:5173. Production MUST set this
# (comma-separated full origins). A bare * is ignored (fail closed).
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# ── Vendored Java platform: secrets that used to be committed ────────────────
#
# Everything in this block replaced a literal that was sitting in a git-tracked
# `application.properties`. They are listed here so an operator knows they
# exist; they are deliberately COMMENTED OUT and have NO defaults in the
# properties files, because the desired behaviour is that a service which has
# not been given one REFUSES TO START. A wallet service that boots on a stale
# credential is worse than one that does not boot: the first loses money
# quietly, the second pages someone.
#
# Uncomment and fill only what the service you are running actually needs.
# Generate anything secret with:  openssl rand -base64 32
#
# See docs/A1.4-WALLET-SECRETS-PERIMETER-2026-07-30.md for which of these are
# LIVE credentials the owner must rotate, and which are dead config.

# -- 01_wallet_rpc (custody: these services hold private keys) ----------------
# Shared secret on every /rpc/** call. Minimum 24 chars or the service refuses
# to start (RpcSecurityConfig). Without it the withdrawal endpoints are open to
# anyone who can reach the port.
# WALLET_RPC_AUTH_TOKEN=

# Deposit-keystore password for the ETH-family services (eth, erc-token,
# erc-eusdt). READ docs/RUNBOOK-ETH-KEYSTORE-REENCRYPTION.md BEFORE SETTING
# THIS ON A DEPLOYMENT THAT ALREADY HAS KEYSTORES — existing files were created
# with an empty password and stop decrypting the moment this becomes real.
# ETH_KEYSTORE_PASSWORD=
# ETH_WITHDRAW_WALLET_PASSWORD=

# Address book for the wallet RPC services (MongoDB).
# WALLET_MONGODB_URI=mongodb://user:pass@host:27017/wallet

# Node RPC endpoints. These URLs embed node credentials, which is why they are
# secrets and not settings: they control a node that can sign and broadcast.
# BTC_NODE_RPC_URL=http://user:pass@host:8332/
# USDT_NODE_RPC_URL=http://user:pass@host:8332/
# ACT_NODE_RPC_URL=http://user:pass@host:8900/rpc
# USDT_WALLET_PASSWORD=

# Bytom node. The access token is <id>:<secret>.
# BYTOM_CLIENT_ACCESS_TOKEN=
# BYTOM_WALLET_PASSWORD=

# Third-party chain data. Read on the deposit watcher path, so an absent key
# means missed deposits rather than a loud failure — hence no default.
# ETHERSCAN_API_KEY=
# EOS_BLOCK_API_KEY=

# -- 00_framework (the vendored exchange services) ---------------------------
# Guards the Spring Boot actuator under management.context-path. This one is
# not optional hygiene: with the old committed literal, /monitor/heapdump on a
# PUBLISHED port returned the entire process heap to anyone holding this repo.
# COINEX_ACTUATOR_PASSWORD=

# Redis holding the exchange HTTP sessions. Also consumed by the vendored
# exchange compose file, which currently supplies a weak default — see the
# perimeter doc; that default should go.
# COINEX_REDIS_PASSWORD=

# COINEX_MONGODB_URI=mongodb://host:27017/bitrade
# COINEX_MAIL_PASSWORD=
# SMS_GATEWAY_PASSWORD=
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# GEETEST_PRIVATE_KEY=
# WATERPROOF_APP_SECRET_KEY=
