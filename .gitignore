node_modules/
dist/
build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# The vendored exchange front-ends keep their webpack CONFIG in build/, not
# build output. The blanket `build/` rule above silently dropped all 13 files
# when the vendor tree was committed, so the app could not be started from a
# clean clone at all — `npm run dev` died on a missing webpack.dev.conf.js and
# nothing in CI noticed, because nothing in CI builds them.
!vendor/*/05_Web_Front/build/
!vendor/*/05_Web_Front/build/**
!vendor/*/04_Web_Admin/build/
!vendor/*/04_Web_Admin/build/**

.env
.env.local
.env.*.local
!.env.example

*.log
npm-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# infra volumes
.docker-data/
