#!/bin/sh
#
# Refuse a direct push to main + require format:check before any push.
# Safety net only — --no-verify bypasses; real enforcement is branch protection.

# P1: format:check covers tooling/scripts/*.mjs (what red-trunked main via #471).
if command -v pnpm >/dev/null 2>&1; then
  if ! pnpm format:check; then
    cat >&2 <<'MSG'

  ✖ pnpm format:check failed — refuse push.

    Fix: pnpm format   (or prettier --write on the named files)
    This is the gate that failed when #471 merged before CI (swarm.mjs).

MSG
    exit 1
  fi
elif [ -x ./node_modules/.bin/prettier ]; then
  if ! ./node_modules/.bin/prettier --check "**/*.{ts,tsx,mjs,js,md,json,yml,yaml}"; then
    echo "✖ prettier --check failed — refuse push." >&2
    exit 1
  fi
fi

protected="main"
remote_ref_prefix="refs/heads/"

while read -r local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#$remote_ref_prefix}"

  if [ "$branch" = "$protected" ]; then
    cat >&2 <<'MESSAGE'

  ✖ Direct push to main refused.

    main is always deployable and changes reach it through a reviewed PR
    (CONTRIBUTING.md §1). Nothing here is urgent enough to skip that.

    Instead:
      pnpm wt feat/your-change
      git push -u origin feat/your-change
      gh pr create --fill

    If you genuinely need to push main (initial import, protection repair):
      git push --no-verify

MESSAGE
    exit 1
  fi
done

exit 0
