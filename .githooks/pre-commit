#!/bin/sh
# Map files do not ride product PRs. Only chore/graphify-* may stage graphify-out/.
# Fail-open if we cannot read the branch. Honor GRAPHIFY_SKIP_HOOK during rebase.
[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
[ -n "$branch" ] || exit 0
[ "$branch" = "HEAD" ] && exit 0
staged=$(git diff --cached --name-only 2>/dev/null) || exit 0
echo "$staged" | grep -q '^graphify-out/' || exit 0
case "$branch" in
  chore/graphify-*) exit 0 ;;
esac
echo "map does not ride product PRs; unstage graphify-out/ (branch $branch is not chore/graphify-*)"
exit 1
